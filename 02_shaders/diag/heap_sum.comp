#version 450
// Minimal shader for checking the dma-heap import round trip (Appendix B step 1 = P0 gate, `--probe heapimport`).
//
// The goal is not performance but **separating "the Vulkan import formally succeeded" from "the GPU actually
// sees the correct data"**. The GPU recomputes the byte sum of a known pattern the CPU wrote via mmap(heap_fd)
// and compares it with the host-computed value. Same role as kChecksum in `yolo_decode.comp`, but that one
// is tied to YoloPostproc's tensor layout (NHCW, 6 tensors), so it cannot be used to measure a single import buffer.
//
// The sum is **uint32 wraparound**. The host must add with the same width to match.
// The workgroup count is fixed by the host (kSumGroups) and a grid-stride loop covers the whole range — even though
// the buffer size differs per each of the 6 tensors, the dispatch shape is the same, so the comparison is clean.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer Src { uint w[]; } src;
layout(std430, set = 0, binding = 1) buffer Dst { uint sum; uint words; } dst;

layout(push_constant, std430) uniform Params {
    uint n_words;   // number of 32-bit words to read (= VkBuffer range / 4)
} pc;

shared uint s_part[64];

void main() {
    const uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    uint acc = 0u;
    // The loop condition does the bounds check. No early return before barrier(), so the barrier does not diverge.
    for (uint i = gl_GlobalInvocationID.x; i < pc.n_words; i += stride) {
        const uint v = src.w[i];
        acc += (v & 0xffu) + ((v >> 8) & 0xffu) + ((v >> 16) & 0xffu) + (v >> 24);
    }
    s_part[gl_LocalInvocationID.x] = acc;
    barrier();
    for (uint st = gl_WorkGroupSize.x / 2u; st > 0u; st >>= 1) {
        if (gl_LocalInvocationID.x < st) s_part[gl_LocalInvocationID.x] += s_part[gl_LocalInvocationID.x + st];
        barrier();
    }
    if (gl_LocalInvocationID.x == 0u) {
        atomicAdd(dst.sum, s_part[0]);
        atomicAdd(dst.words, 1u);   // evidence that the dispatch really ran (= number of workgroups)
    }
}

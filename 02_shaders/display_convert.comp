#version 450
// SAND128 NV12 dma-buf → RGBA storage image for display (BT.709 limited → sRGB, gamma-encoded values as is)
//
// Reference implementation: address rules in 01_src/ref/sand.hpp + color formula in 01_src/ref/cpu_letterbox.hpp.
// **The BT.709 formula is the shared include 02_shaders/bt709.glsl** (also used by sand_letterbox.comp) —
// the displayed color must not differ by even one bit from the preprocessing path.
//
// The output is a VK_FORMAT_R8G8B8A8_UNORM storage image. Reasons (plan §5.6):
//   ① In Vulkan, _SRGB formats cannot be storage images
//   ② shaderStorageImageWriteWithoutFormat=false, so a format qualifier is mandatory, and GLSL has no bgra8 → only rgba8
//   ③ The values produced by the formula below are already gamma-encoded sRGB 0~255 → with UNORM they pass through unconverted
// byte/255.0 returns exactly to the original byte under UNORM quantization (round(v*255)).
//
// ── Two paths (specialization constant 2: kUniformScale) ──────────────────────────────────────
//  kUniformScale = false : **1:1 path** (dst == src). This is the default display path.
//      It is **not** a copy of sand_letterbox.comp — being 1:1, there is no scale LUT, no 4-tap bilinear,
//      and no letterbox padding. Only de-SAND address computation + BT.709 + RGBA packing.
//      · Luma: sx = dx, fx = 0, so there is **exactly 1 sample**. The 4 pixels are 4 consecutive bytes in the same SAND column
//        (dst_w is a multiple of 4, and the SAND column width 128 is a multiple of 4), so all are fetched with **a single word load**.
//      · Chroma: chroma_location=left, so vertically interpolation between two rows is needed (fcy), and horizontally it is 0 at even dx
//        and exactly 0.5 at odd dx. The 4 pixels need only three chroma columns q0,q1,q2 across two rows, so
//        it finishes with **4 word loads** (q0,q1 in one word, q2 in the next word).
//      → 5 loads per 4 pixels. Word loads + shifts are used instead of byte loads because on V3D a byte load
//        takes 4x the instructions (same discipline as the measured rationale in the sand_letterbox.comp comments).
//      · Interpolation order matches the CPU reference exactly (cpu_letterbox.hpp: **horizontal first, vertical second**).
//        Changing the order changes the floating-point result and breaks bit-exactness.
//  kUniformScale = true : **uniform scale path** (only when the window size differs from the source). Only here is it bilinear, and
//      it uses the same column LUT as sand_letterbox.comp (on V3D a 32-bit integer multiply is umul24 emulation and expensive).
//
// V3D optimization discipline (all the same as the measured rationale in the sand_letterbox.comp comments):
//   word loads + shifts / avoid per-lane branches / no local arrays + loops (the compiler cannot unroll them) /
//   minimize 32-bit integer multiplies (the 1:1 path has only 2 column multiplies per 4 pixels) / large workgroup invocation count (64~256).
// No barrier()/shared memory is used, so out-of-range invocations may return immediately.

// Workgroup size: specialization constant 0/1 (host DisplayConvertConfig::local_size_x/y)
layout(local_size_x_id = 0, local_size_y_id = 1, local_size_z = 1) in;
// Whether to use the uniform scale path: specialization constant 2
layout(constant_id = 2) const bool kUniformScale = false;

layout(std430, set = 0, binding = 0) readonly buffer YBuf { uint y_words[]; };
layout(std430, set = 0, binding = 1) readonly buffer UVBuf { uint uv_words[]; };
layout(rgba8, set = 0, binding = 2) uniform writeonly image2D dst_image;
// Column LUT (used only when kUniformScale. Same convention as the one in sand_letterbox.comp)
layout(std430, set = 0, binding = 3) readonly buffer ColLut { uvec4 col_lut[]; };

// Same order as host DisplayConvertPush (56 B)
layout(push_constant, std430) uniform Params {
    uint y_offset;      // multiple of 4 (checked by host)
    uint y_col_stride;  // bytes. A multiple of 128, so >> 2 gives the word stride
    uint uv_offset;     // multiple of 4 (checked by host)
    uint uv_col_stride;
    int src_w;
    int src_h;
    int dst_w;          // multiple of 4 recommended (works otherwise too — out-of-range imageStore is discarded)
    int dst_h;
    int pad_x;
    int pad_y;
    int new_w;
    int new_h;
    float inv_scale;
    uint pad_value;
} pc;

// to_u8() + bt709_to_rgb(): BT.709 limited → RGB, the same include as sand_letterbox.comp.
#extension GL_GOOGLE_include_directive : require
#include "bt709.glsl"

void store_px(int dx, int dy, uvec3 rgb) {
    // Vulkan guarantees imageStore to out-of-range coordinates is discarded, so no bounds branch is needed.
    imageStore(dst_image, ivec2(dx, dy), vec4(vec3(rgb) / 255.0, 1.0));
}

float byte_at(uint w, uint sh) { return float((w >> sh) & 0xffu); }

// ── Uniform scale path: same LUT convention as shade() in sand_letterbox.comp ────────────────
uvec3 shade_lut(int dx, uint pv, uint yw0, uint yw1, float fy, uint cw0, uint cw1, float fcy) {
    const uvec4 cols = col_lut[2 * dx];
    const uvec4 aux = col_lut[2 * dx + 1];
    const float fx = uintBitsToFloat(aux.y);
    const float fcx = uintBitsToFloat(aux.z);
    const uint sy0 = aux.x & 0xffu;
    const uint sy1 = (aux.x >> 8) & 0xffu;
    const uint su0 = (aux.x >> 16) & 0xffu;
    const uint su1 = aux.x >> 24;

    float a = byte_at(y_words[yw0 + cols.x], sy0);
    float b = byte_at(y_words[yw0 + cols.y], sy1);
    float c = byte_at(y_words[yw1 + cols.x], sy0);
    float d = byte_at(y_words[yw1 + cols.y], sy1);
    precise float top = a + (b - a) * fx;
    precise float bot = c + (d - c) * fx;
    precise float Y = top + (bot - top) * fy;

    uint wa = uv_words[cw0 + cols.z] >> su0;
    uint wc = uv_words[cw1 + cols.z] >> su0;
    vec2 ua = vec2(float(wa & 0xffu), float((wa >> 8) & 0xffu));
    vec2 uc = vec2(float(wc & 0xffu), float((wc >> 8) & 0xffu));
    uint wb = uv_words[cw0 + cols.w] >> su1;
    uint wd = uv_words[cw1 + cols.w] >> su1;
    vec2 ub = vec2(float(wb & 0xffu), float((wb >> 8) & 0xffu));
    vec2 ud = vec2(float(wd & 0xffu), float((wd >> 8) & 0xffu));
    precise vec2 ctop = ua + (ub - ua) * fcx;
    precise vec2 cbot = uc + (ud - uc) * fcx;
    precise vec2 UV = ctop + (cbot - ctop) * fcy;

    const uvec3 rgb = bt709_to_rgb(Y, UV.x, UV.y);
    return (aux.w != 0u) ? uvec3(pv) : rgb;
}

void scale_path(int dx0, int dy) {
    const uint pv = pc.pad_value & 0xffu;
    const bool row_in = dy >= pc.pad_y && dy < pc.pad_y + pc.new_h;
    if (!row_in) {
        const uvec3 p = uvec3(pv);
        store_px(dx0 + 0, dy, p);
        store_px(dx0 + 1, dy, p);
        store_px(dx0 + 2, dy, p);
        store_px(dx0 + 3, dy, p);
        return;
    }
    precise float sy = (float(dy - pc.pad_y) + 0.5) * pc.inv_scale - 0.5;
    precise float ys = clamp(sy, 0.0, float(pc.src_h - 1));
    int y0 = int(ys);
    int y1 = min(y0 + 1, pc.src_h - 1);
    precise float fy = ys - float(y0);

    int ch = pc.src_h >> 1;
    precise float cy = (sy + 0.5) * 0.5 - 0.5;
    precise float cys = clamp(cy, 0.0, float(ch - 1));
    int cy0 = int(cys);
    int cy1 = min(cy0 + 1, ch - 1);
    precise float fcy = cys - float(cy0);

    const uint yw0 = (pc.y_offset >> 2) + uint(y0) * 32u;
    const uint yw1 = (pc.y_offset >> 2) + uint(y1) * 32u;
    const uint cw0 = (pc.uv_offset >> 2) + uint(cy0) * 32u;
    const uint cw1 = (pc.uv_offset >> 2) + uint(cy1) * 32u;

    // Write out the 4 pixels explicitly (with local arrays/loops the V3D compiler cannot unroll them and it gets slower)
    store_px(dx0 + 0, dy, shade_lut(dx0 + 0, pv, yw0, yw1, fy, cw0, cw1, fcy));
    store_px(dx0 + 1, dy, shade_lut(dx0 + 1, pv, yw0, yw1, fy, cw0, cw1, fcy));
    store_px(dx0 + 2, dy, shade_lut(dx0 + 2, pv, yw0, yw1, fy, cw0, cw1, fcy));
    store_px(dx0 + 3, dy, shade_lut(dx0 + 3, pv, yw0, yw1, fy, cw0, cw1, fcy));
}

// ── 1:1 path ─────────────────────────────────────────────────────────────────────────────────
void fast_path(int dx0, int dy) {
    // Luma: 4 consecutive bytes in the same SAND column = 1 word. (dx0 % 4 == 0 and column width 128 is also a multiple of 4)
    const uint ycsw = pc.y_col_stride >> 2;
    const uint yrow = (pc.y_offset >> 2) + uint(dy) * 32u;
    const uint yw = y_words[yrow + uint(dx0 >> 7) * ycsw + uint((dx0 & 127) >> 2)];

    // Chroma row: chroma_location=left → vertically the middle of two luma rows. Same float operation order as the CPU reference.
    const int ch = pc.src_h >> 1;
    precise float sy = float(dy);
    precise float cy = (sy + 0.5) * 0.5 - 0.5;
    precise float cys = clamp(cy, 0.0, float(ch - 1));
    const int cy0 = int(cys);
    const int cy1 = min(cy0 + 1, ch - 1);
    precise float fcy = cys - float(cy0);

    const uint ucsw = pc.uv_col_stride >> 2;
    const uint crow0 = (pc.uv_offset >> 2) + uint(cy0) * 32u;
    const uint crow1 = (pc.uv_offset >> 2) + uint(cy1) * 32u;

    // Chroma columns q0 = dx0/2, q1 = q0+1 → bytes dx0..dx0+3 = 1 word (U0,V0,U1,V1)
    const uint coff0 = uint(dx0 >> 7) * ucsw + uint((dx0 & 127) >> 2);
    const uint wa = uv_words[crow0 + coff0];
    const uint wb = uv_words[crow1 + coff0];
    // Chroma column q2 = q0+2 → byte dx0+4. In the last group it is clamped to cw-1 (the CPU's min(cx0+1, cw-1)).
    const int bx2 = min(dx0 + 4, pc.src_w - 2);
    const uint coff2 = uint(bx2 >> 7) * ucsw + uint((bx2 & 127) >> 2);
    const uint sh2 = uint(bx2 & 3) * 8u;   // 0 if not clamped, 16 if clamped
    const uint wc = uv_words[crow0 + coff2] >> sh2;
    const uint wd = uv_words[crow1 + coff2] >> sh2;

    // (U, V) pairs: a* = row cy0, b* = row cy1
    const vec2 a0 = vec2(float(wa & 0xffu), float((wa >> 8) & 0xffu));
    const vec2 a1 = vec2(float((wa >> 16) & 0xffu), float(wa >> 24));
    const vec2 a2 = vec2(float(wc & 0xffu), float((wc >> 8) & 0xffu));
    const vec2 b0 = vec2(float(wb & 0xffu), float((wb >> 8) & 0xffu));
    const vec2 b1 = vec2(float((wb >> 16) & 0xffu), float(wb >> 24));
    const vec2 b2 = vec2(float(wd & 0xffu), float((wd >> 8) & 0xffu));

    // Even dx: fcx = 0 → the horizontal interpolation result is that column's value as is (a + (b-a)*0.0 == a, bit for bit).
    precise vec2 uv0 = a0 + (b0 - a0) * fcy;
    precise vec2 uv2 = a1 + (b1 - a1) * fcy;
    // Odd dx: fcx = 0.5. **Horizontal first, vertical second** — must be the same order as the CPU reference (bilinear_u8).
    precise vec2 t1 = a0 + (a1 - a0) * 0.5;
    precise vec2 o1 = b0 + (b1 - b0) * 0.5;
    precise vec2 uv1 = t1 + (o1 - t1) * fcy;
    precise vec2 t3 = a1 + (a2 - a1) * 0.5;
    precise vec2 o3 = b1 + (b2 - b1) * 0.5;
    precise vec2 uv3 = t3 + (o3 - t3) * fcy;

    store_px(dx0 + 0, dy, bt709_to_rgb(byte_at(yw, 0u), uv0.x, uv0.y));
    store_px(dx0 + 1, dy, bt709_to_rgb(byte_at(yw, 8u), uv1.x, uv1.y));
    store_px(dx0 + 2, dy, bt709_to_rgb(byte_at(yw, 16u), uv2.x, uv2.y));
    store_px(dx0 + 3, dy, bt709_to_rgb(byte_at(yw, 24u), uv3.x, uv3.y));
}

void main() {
    const int groups_per_row = (pc.dst_w + 3) >> 2;
    const int gx = int(gl_GlobalInvocationID.x);
    const int dy = int(gl_GlobalInvocationID.y);
    if (gx >= groups_per_row || dy >= pc.dst_h) return; // no barrier
    const int dx0 = gx * 4;
    if (kUniformScale) scale_path(dx0, dy);
    else fast_path(dx0, dy);
}

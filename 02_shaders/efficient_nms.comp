#version 450
// Per-class greedy NMS — a Vulkan (V3D) translation of the TensorRT EfficientNMS structure (08_learn/11_tensorrt_efficient_nms.md).
// The input is the candidate DetBuf filled by `yolo_decode.comp` (pass 1); the output is a DetBuf of the same format (survivors only, in sorted order).
//
// ── Reference implementation ─────────────────────────────────────────────────────────────────
// **The source of truth for the semantics is `cpu_nms_greedy_by_class()` and `iou_xyxy()` in `01_src/ref/cpu_yolov8_decode.hpp`.**
// The result **must be bit-identical** to that function (count, order, class, anchor_key, score, coordinates).
//   · Total order: score descending, anchor_key ascending (anchor_key is unique within a frame)
//   · Within the same class, suppress later candidates with IoU >= iou_thr. A suppressed candidate suppresses nothing
//   · max_per_class per class. Candidates of a class whose quota is full are dropped without any suppression work
//
// ── TRT stages → this shader ─────────────────────────────────────────────────────────────────
//   Filter(§5.1)   : already done by the atomicAdd emit in yolo_decode.comp. Not done here
//   Sort(§5.3)     : shared-memory **bitonic sort** in a single workgroup. Key = (score bits descending, anchor_key ascending).
//                    score is positive, so uint bit order = float order. No int64, so a two-stage comparison is used
//   NMS(§5.4)      : tiles + blockState broadcast. Each invocation owns kTiles candidates, and the owner (leader) of i
//                    broadcasts the verdict via s_block_state — 1 survives / -1 already dropped or class quota exceeded / -2 global limit
//   Write(§5.5)    : compact-write survivors in sorted order. sigmoid is applied only to survivors when kScoreSigmoid
//
// ── IoU decision and guard band ───────────────────────────────────────────────────────────────
// On the CPU side, iou_xyxy is built with -O3 -mcpu=cortex-a76 + GCC's default -ffp-contract=fast, so the sum in `ua` is
// contracted into fmadd (verified in assembly). Vulkan defines even fma() only as "inherited from OpFMul followed by OpFAdd", and division is
// 2.5 ULP, so **the GPU cannot reproduce the CPU's IoU bits.** Therefore we do not divide, and decide by
//   d_hi = inter - iou_hi * ua >= 0  → definitely suppress   (iou_hi = thr + G)
//   d_lo = inter - iou_lo * ua <  0  → definitely keep       (iou_lo = thr - G)
//   in between                       → guard band: set overflow bit 1 (value 2) and the host processes that frame on the CPU
// instead. The rationale for G (error bound about 26u, u = 2^-24) is in the comments of `efficient_nms.hpp`.
// `precise` blocks contraction on the GPU side so the expression keeps the same operation order as the CPU (the bound analysis does not depend on contraction).
//
// ── overflow bits (if nonzero, the host processes that frame on the CPU) ─────────────────────
//   1 : number of candidates > kMaxSelected, or the decode DetBuf already overflowed (count > n_max / overflow != 0)
//   2 : some pair fell inside the IoU guard band
//   4 : class_id >= kNumClasses (input contract violation)
//
// ── V3D constraints ───────────────────────────────────────────────────────────────────────────
//   workgroup <= 256, shared <= 32 KB (the host compares against maxComputeSharedMemorySize at creation), no int64.
//   No local arrays — the tile loop bound is a spec constant, so it is unrolled after specialization.
//   Every barrier() is in uniform control flow (the loop bounds n·P and the broadcast values are uniform values read from shared).

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
layout(constant_id = 1) const uint kMaxSelected = 1024u;   // power of two, <= 4096 (12-bit output position)
layout(constant_id = 2) const uint kNumClasses = 80u;      // <= 65536 (low 16 bits of the state word)
layout(constant_id = 3) const bool kScoreSigmoid = false;  // scores are already probabilities (cpu_yolov8_decode.hpp 2))
layout(constant_id = 4) const bool kClassAgnostic = false;

const uint kLocal = gl_WorkGroupSize.x;
const uint kTiles = (kMaxSelected + kLocal - 1u) / kLocal;

// Same 32 B layout as DetGpu in yolo_decode.comp / overlay_boxes.comp
struct DetGpu {
    float x1, y1, x2, y2;
    float score;
    uint class_id;
    uint anchor_key;
    uint keep;
};

layout(std430, set = 0, binding = 0) readonly buffer InBuf {
    uint in_dispatch[3];
    uint in_count;       // total emit attempts (may exceed n_max)
    uint in_overflow;
    uint in_text_bytes;
    uint in_text[32];
    DetGpu in_dets[];
};

layout(std430, set = 0, binding = 1) writeonly buffer OutBuf {
    uint out_dispatch_x;   // max(count, 1) — overlay indirect dispatch contract
    uint out_dispatch_y;
    uint out_dispatch_z;
    uint out_count;        // number of survivors
    uint out_overflow;     // the fallback bits above
    uint out_text_bytes;
    uint out_text[32];     // unused
    DetGpu out_dets[];
};

layout(push_constant, std430) uniform Params {
    float iou_thr;         // 0.7
    float iou_lo;          // thr - G
    float iou_hi;          // thr + G
    uint max_per_class;    // 100
    uint max_output;       // 0 = unlimited (same as the CPU reference)
    uint n_max;            // input DetBuf capacity (max_dets)
} pc;

const uint kDead = 1u << 31;
const uint kSel = 1u << 30;
const uint kClassMask = 0xffffu;
const float kTiny = 1e-30;   // areas near denormals may differ depending on FTZ, so send them to the guard band

// Sort stage: s_a = score bits, s_b = anchor_key.  Reused after sorting: s_a = x1 bits, s_b = y1 bits.
shared uint s_a[kMaxSelected];
shared uint s_b[kMaxSelected];
shared uint s_idx[kMaxSelected];    // sorted position → input dets index
shared float s_x2[kMaxSelected];
shared float s_y2[kMaxSelected];
shared uint s_st[kMaxSelected];     // class(0..15) | output position(16..27) | kSel | kDead
shared uint s_kept[kNumClasses];
shared int s_block_state;
shared uint s_n;
shared uint s_pow2;
shared uint s_flags;
shared uint s_total;

// Does a come before b in the (score bits, key) total order
bool before(uint sa, uint ka, uint sb, uint kb) { return sa > sb || (sa == sb && ka < kb); }

// 0 = keep, 1 = suppress, +2 = guard band. a is the survivor (i), b is the candidate (j) — same order as iou_xyxy(dets[i], dets[j]).
uint iou_decide(float ax1, float ay1, float ax2, float ay2, float bx1, float by1, float bx2, float by2) {
    precise float ix = max(0.0, min(ax2, bx2) - max(ax1, bx1));
    precise float iy = max(0.0, min(ay2, by2) - max(ay1, by1));
    precise float inter = ix * iy;
    precise float aa = (ax2 - ax1) * (ay2 - ay1);
    precise float ab = (bx2 - bx1) * (by2 - by1);
    precise float ua = aa + ab - inter;
    if ((aa > 0.0 && aa < kTiny) || (ab > 0.0 && ab < kTiny) || (inter > 0.0 && inter < kTiny))
        return 2u | ((ua > 0.0 && inter >= pc.iou_thr * ua) ? 1u : 0u);
    if (!(ua > 0.0)) return (0.0 >= pc.iou_thr) ? 1u : 0u;   // CPU: if ua > 0 does not hold, IoU = 0
    precise float d_hi = inter - pc.iou_hi * ua;
    if (d_hi >= 0.0) return 1u;
    precise float d_lo = inter - pc.iou_lo * ua;
    if (d_lo < 0.0) return 0u;
    precise float d = inter - pc.iou_thr * ua;
    return 2u | (d >= 0.0 ? 1u : 0u);
}

void write_header(uint total, uint flags) {
    out_dispatch_x = max(total, 1u);
    out_dispatch_y = 1u;
    out_dispatch_z = 1u;
    out_count = total;
    out_overflow = flags;
    out_text_bytes = 0u;
}

void main() {
    const uint tid = gl_LocalInvocationID.x;

    // ── 0) Input size check and initialization ─────────────────────────────────────────────
    if (tid == 0u) {
        const uint raw = in_count;
        const uint n = min(raw, pc.n_max);
        uint flags = 0u;
        if (in_overflow != 0u || raw > pc.n_max || n > kMaxSelected) flags |= 1u;   // do not truncate → CPU
        uint p = 1u;
        while (p < n) p <<= 1;
        s_n = n;
        s_pow2 = p;
        s_flags = flags;
        s_total = 0u;
        s_block_state = 0;
    }
    for (uint c = tid; c < kNumClasses; c += kLocal) s_kept[c] = 0u;
    barrier();
    if ((s_flags & 1u) != 0u) {   // uniform branch (all see the same shared value) — no barrier after this
        if (tid == 0u) write_header(0u, s_flags);
        return;
    }
    const uint n = s_n;
    const uint P = s_pow2;

    // ── 1) Load sort keys (pad up to P: score bits 0 sort after any positive score) ──────────
    for (uint t = 0u; t < kTiles; ++t) {
        const uint p = tid + t * kLocal;
        if (p >= P) continue;
        if (p < n) {
            s_a[p] = floatBitsToUint(in_dets[p].score);
            s_b[p] = in_dets[p].anchor_key;
            if (in_dets[p].class_id >= kNumClasses) atomicOr(s_flags, 4u);
        } else {
            s_a[p] = 0u;
            s_b[p] = 0xffffffffu;
        }
        s_idx[p] = p;
    }
    barrier();
    if ((s_flags & 4u) != 0u) {
        if (tid == 0u) write_header(0u, s_flags);
        return;
    }

    // ── 2) bitonic sort (replaces the radix sort of TRT §5.3). The owner of p writes both of the pair (p, p^j) ──
    for (uint k = 2u; k <= P; k <<= 1) {
        for (uint j = k >> 1; j > 0u; j >>= 1) {
            for (uint t = 0u; t < kTiles; ++t) {
                const uint p = tid + t * kLocal;
                const uint l = p ^ j;
                if (p >= P || l <= p) continue;
                const uint sa = s_a[p], ka = s_b[p], sb = s_a[l], kb = s_b[l];
                const bool a_first = before(sa, ka, sb, kb);
                const bool fwd = (p & k) == 0u;   // this block sorts in the total-order direction
                if (fwd != a_first) {
                    s_a[p] = sb;
                    s_b[p] = kb;
                    s_a[l] = sa;
                    s_b[l] = ka;
                    const uint ti = s_idx[p];
                    s_idx[p] = s_idx[l];
                    s_idx[l] = ti;
                }
            }
            barrier();
        }
    }

    // ── 3) Load boxes and classes in sorted order (reusing s_a/s_b) ──────────────────────────
    for (uint t = 0u; t < kTiles; ++t) {
        const uint p = tid + t * kLocal;
        if (p >= n) continue;
        const uint i = s_idx[p];
        s_a[p] = floatBitsToUint(in_dets[i].x1);
        s_b[p] = floatBitsToUint(in_dets[i].y1);
        s_x2[p] = in_dets[i].x2;
        s_y2[p] = in_dets[i].y2;
        s_st[p] = in_dets[i].class_id;
    }
    barrier();

    // ── 4) Main NMS: tiles + blockState broadcast (TRT §5.4) ───────────────────────────────
    for (uint i = 0u; i < n; ++i) {
        if (i % kLocal == tid) {   // leader = owner of i
            const uint st = s_st[i];
            const uint c = st & kClassMask;
            int v;
            if ((st & kDead) != 0u) {
                v = -1;                                   // already suppressed
            } else if (s_kept[c] >= pc.max_per_class) {
                v = -1;                                   // class quota exceeded — like the CPU, no suppression work
                s_st[i] = st | kDead;
            } else if (pc.max_output != 0u && s_total >= pc.max_output) {
                v = -2;                                   // global limit → early exit
            } else {
                v = 1;                                    // confirmed survivor
                s_kept[c] += 1u;
                s_st[i] = st | kSel | (s_total << 16);
                s_total += 1u;
            }
            s_block_state = v;
        }
        barrier();
        const int v = s_block_state;
        if (v == -2) break;   // uniform
        if (v == 1) {
            const float ax1 = uintBitsToFloat(s_a[i]);
            const float ay1 = uintBitsToFloat(s_b[i]);
            const float ax2 = s_x2[i];
            const float ay2 = s_y2[i];
            const uint ci = s_st[i] & kClassMask;
            for (uint t = 0u; t < kTiles; ++t) {
                const uint j = tid + t * kLocal;
                if (j <= i || j >= n) continue;
                const uint st = s_st[j];
                if ((st & kDead) != 0u) continue;   // a candidate dropped once is never compared again
                if (!kClassAgnostic && (st & kClassMask) != ci) continue;
                const uint r = iou_decide(ax1, ay1, ax2, ay2, uintBitsToFloat(s_a[j]), uintBitsToFloat(s_b[j]),
                                          s_x2[j], s_y2[j]);
                if ((r & 2u) != 0u) atomicOr(s_flags, 2u);
                if ((r & 1u) != 0u) s_st[j] = st | kDead;
            }
        }
        barrier();
    }
    barrier();

    // ── 5) Write results (TRT §5.5): compact survivors in sorted order ─────────────────────
    for (uint t = 0u; t < kTiles; ++t) {
        const uint p = tid + t * kLocal;
        if (p >= n) continue;
        const uint st = s_st[p];
        if ((st & kSel) == 0u) continue;
        const uint pos = (st >> 16) & 0xfffu;
        DetGpu d = in_dets[s_idx[p]];
        if (kScoreSigmoid) d.score = 1.0 / (1.0 + exp(-d.score));
        d.keep = 1u;
        out_dets[pos] = d;
    }
    if (tid == 0u) write_header(s_total, s_flags);
}

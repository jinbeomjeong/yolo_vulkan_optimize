#version 450
// A **compute rasterizer that writes box outlines + class labels + one HUD line directly into the display RGBA storage image**.
//
// ── Why compute (plan §5.4) ───────────────────────────────────────────────────────────────
// **No graphics pipeline is used.** V3D is tile-based, so opening a render pass with LOAD_OP_LOAD on an image
// already written by compute makes the tiler read and rewrite the whole framebuffer (720p RGBA 3.69 MB x 2
// ≈ 3.6 ms). Not a cost worth paying to draw a few boxes. Compute only does scatter writes, so that cost is 0.
//
// ── Boundary conventions ─────────────────────────────────────────────────────────────────────────────────
// **The original of the conventions is the R0~R8 block at the top of `01_src/ref/overlay_reference.hpp`.** This shader is the
// GPU translation of those conventions, and `05_tests/test_overlay.cpp` compares it against the CPU translation of the same conventions (`overlay_cpu_render()`)
// with **max error 0**. When changing the conventions, fix that header first.
//   R1  integer rectangle after round-half-up is a **closed range** [ix1,ix2]x[iy1,iy2] (width = ix2-ix1+1)
//   R2  if a coordinate has NaN/Inf, skip that detection entirely
//   R3  outlines grow **inward only** → boxes touching the screen edge are not cut off either
//   R5  the integer rectangle is computed from unclipped coordinates and **clipped to the screen just before writing**
//   R6  label origin = above the box's top-left; if 16*s does not fit above, inside the box at the top. score is two integer digits
//   R7  color = class_color(clamp(cid,0,79)) RGB, alpha always 255. HUD is white, fixed at (4,4)
// Glyph unpacking (row/bit order, integer scale) follows conventions 1)~8) in `01_src/ref/glyph_font_8x16.hpp`.
//
// ── Dispatch convention ─────────────────────────────────────────────────────────────────────────────
// **One workgroup per detection.** vkCmdDispatchIndirect(cb, det_buf, 0) reads the uvec3 dispatch at the
// start of DetBuf (VkDispatchIndirectCommand compatible, offset 0).
//   · The producer (currently the CPU, later a GPU NMS shader) writes `dispatch = (max(count,1), 1, 1)`.
//   · Workgroup g draws detection g when g < count.
//   · **Workgroup 0 additionally draws one HUD line.** So even when count == 0 (dispatch.x = 1)
//     the HUD appears. Even if a producer mistakenly writes dispatch.x = count, the detection mapping is still correct
//     (only the HUD disappears) — it was split this way on purpose so the indices do not shift.
// local_size_x is spec constant 0 (default 64 = a multiple of the V3D subgroup 16).
//
// ── V3D discipline (same measured basis as the comments in sand_letterbox.comp) ────────────────────────────────────
//   · **word load + shift** instead of byte loads (glyphs, names and HUD characters all)
//   · no per-pixel branches → draw the four sides as **4 rectangles pre-clipped to the screen** and
//     absorb clipping into the loop bounds (the outline condition is not evaluated per pixel)
//   · 32-bit integer multiplication is umul24 emulation and expensive → multiplications are grouped to once per glyph cell
//   · no local arrays + loops (the compiler cannot unroll them) → label characters are generated on the fly by a function
//   · no barrier()/shared memory is used, so early return is harmless even if divergent

// spec 0 = local_size_x (host OverlayConfig::local_size_x)
layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
// spec 1 = whether to draw text (labels + HUD). spec 2 = integer scale s.
layout(constant_id = 1) const bool kDrawText = true;
layout(constant_id = 2) const int kTextScale = 1;

// R7: HUD origin (same values as kHudOriginX/Y in overlay_reference.hpp)
const int kHudOriginX = 4;
const int kHudOriginY = 4;

// 32 B. **Same layout** as Rec of the postproc track (§4.3) (anchor_key/keep use the pad slots).
struct DetGpu {
    float x1, y1, x2, y2;
    float score;
    uint class_id;
    uint anchor_key;
    uint keep;
};

// ── Output target: two variants (same source, split by a preprocessor macro) ────────────────────────────────────
//   default            : rgba8 storage image (swapchain/offscreen composition path, overlay_boxes.spv)
//   YVO_OVERLAY_BUFFER : packed RGBA8 storage buffer (overlay_boxes_buf.spv). It is the dma-buf for the HVS overlay plane.
//     V3D does not give STORAGE_IMAGE to LINEAR-tiled RGBA8 (no bit in linearTilingFeatures), so
//     a LINEAR image cannot be exported → write directly into a buffer with a pitch (in pixels). Memory byte order is
//     R,G,B,A (x of packUnorm4x8 is the least significant byte) = DRM_FORMAT_ABGR8888 (AB24).
//     The buffer path lacks imageStore's "out-of-range writes are discarded" guarantee, so store_px checks bounds itself.
//     dst_pitch and erase follow the push constants: if erase != 0, (0,0,0,0) is written to the same set of pixels
//     (a pass that erases only the previous boxes when a ring entry is reused — see overlay_plane.hpp).
#ifdef YVO_OVERLAY_BUFFER
layout(std430, set = 0, binding = 0) writeonly buffer DstBuf {
    uint dst_px[];
};
#define STORE_PX(p, c) store_px(p, c)
#else
layout(rgba8, set = 0, binding = 0) uniform writeonly image2D dst_image;
#define STORE_PX(p, c) imageStore(dst_image, p, c)
#endif

// std430: dispatch 0..11 / count 12 / overflow 16 / text_bytes 20 / text[32] 24..151 / dets 152..
// Kept in agreement with the host OverlayDetBufHeader (152 B) via static_assert.
layout(std430, set = 0, binding = 1) readonly buffer DetBuf {
    uvec3 dispatch;    // VkDispatchIndirectCommand compatible (offset 0)
    uint count;
    uint overflow;
    uint text_bytes;
    uint text[32];     // HUD ASCII (128 B)
    DetGpu dets[];
};

// Glyph table + COCO name table in one buffer (V3D has a limit of 8 storage buffers, and both are read-only constants).
layout(std430, set = 0, binding = 2) readonly buffer FontBuf {
    uint glyph[380];     // kGlyph8x16 (95 glyphs x 4 words)
    uint name_off[81];   // per-class name start byte offset. name_off[80] = total bytes
    uint name_bytes[];   // ASCII packed 4 bytes at a time
};

layout(push_constant, std430) uniform Params {
    float sx, sy, tx, ty;   // R0 affine (original coordinates → canvas coordinates)
    int dst_w, dst_h;
    int line_width;         // R3
    uint max_dets;          // dets[] cap (count is clamped to this value)
#ifdef YVO_OVERLAY_BUFFER
    int dst_pitch;          // row pitch (in pixels = uint words). byte pitch / 4
    uint erase;             // 1 = write (0,0,0,0) instead of the color
#endif
} pc;

#ifdef YVO_OVERLAY_BUFFER
void store_px(ivec2 p, vec4 c) {
    if (uint(p.x) >= uint(pc.dst_w) || uint(p.y) >= uint(pc.dst_h)) return;
    dst_px[p.y * pc.dst_pitch + p.x] = (pc.erase != 0u) ? 0u : packUnorm4x8(c);
}
#endif

// R1
int rnd(float v) { return int(floor(clamp(v, -32768.0, 32767.0) + 0.5)); }

// R7
vec4 class_color(uint cid) {
    const uint c = min(cid, 79u);
    const uint r = 255u - (c * 29u) % 256u;
    const uint g = (c * 131u + 80u) % 256u;
    const uint b = (c * 67u) % 256u;
    return vec4(vec3(uvec3(r, g, b)) / 255.0, 1.0);
}

uint byte_of(uint w, uint b) { return (w >> (b * 8u)) & 0xffu; }

// ── Band fill: bounds are pre-clipped, so there are no per-pixel branches (R5) ───────────────────────────────
// Horizontally long bands (top/bottom sides): distribute x across invocations per row → writes are contiguous.
void band_h(int x0, int y0, int x1, int y1, vec4 c) {
    x0 = max(x0, 0);
    y0 = max(y0, 0);
    x1 = min(x1, pc.dst_w - 1);
    y1 = min(y1, pc.dst_h - 1);
    const int step = int(gl_WorkGroupSize.x);
    for (int y = y0; y <= y1; ++y)
        for (int x = x0 + int(gl_LocalInvocationID.x); x <= x1; x += step) STORE_PX(ivec2(x, y), c);
}

// Vertically long bands (left/right sides, width = line_width): distribute rows across invocations.
void band_v(int x0, int y0, int x1, int y1, vec4 c) {
    x0 = max(x0, 0);
    y0 = max(y0, 0);
    x1 = min(x1, pc.dst_w - 1);
    y1 = min(y1, pc.dst_h - 1);
    const int step = int(gl_WorkGroupSize.x);
    for (int y = y0 + int(gl_LocalInvocationID.x); y <= y1; y += step)
        for (int x = x0; x <= x1; ++x) STORE_PX(ivec2(x, y), c);
}

// ── Character generation ───────────────────────────────────────────────────────────────────────────────
// HUD: from text[] of DetBuf
uint hud_char(uint j) { return byte_of(text[j >> 2], j & 3u); }

// Label: "<name> <q/100>.<(q/10)%10><q%10>"  (R6). Computes the j-th character directly without building a string.
uint label_char(uint name_o, uint name_l, uint q, uint j) {
    if (j < name_l) {
        const uint k = name_o + j;
        return byte_of(name_bytes[k >> 2], k & 3u);
    }
    const uint r = j - name_l;
    if (r == 0u) return 32u;                      // ' '
    if (r == 1u) return 48u + q / 100u;           // '0' or '1'
    if (r == 2u) return 46u;                      // '.'
    if (r == 3u) return 48u + (q / 10u) % 10u;
    return 48u + q % 10u;
}

// ── Glyph rendering (glyph_font_8x16.hpp conventions 1)~8) + R6) ────────────────────────────────────────
// Work unit = **(character, glyph row)**. 16 per character, so index decomposition needs only shifts and masks
// (`idx >> 4`, `idx & 15`). Character lookup and glyph word load are grouped to **once per row**, 8x fewer than
// per-cell (pixel) distribution, and one unit writes 8*s horizontal pixels × s rows of the screen **contiguously**.
// Measured (1080p, 80 detections, text_scale 2, local_size 128, label section only):
//   per-cell distribution 1.07 ms → per-row distribution 0.82 ms → horizontal bounds check removed 0.56 ms.
void draw_text_run(int x0, int y0, uint nchars, vec4 c, bool hud, uint name_o, uint name_l, uint q) {
    const int s = max(kTextScale, 1);
    const uint units = nchars * 16u;
    const uint step = gl_WorkGroupSize.x;
    for (uint idx = gl_LocalInvocationID.x; idx < units; idx += step) {
        const uint ci = idx >> 4;
        const int row = int(idx & 15u);
        const uint ch = hud ? hud_char(ci) : label_char(name_o, name_l, q, ci);
        // Convention 1): outside 32~126 folds to space (g = 0) → no pixel is drawn
        const uint g = (ch >= 32u && ch <= 126u) ? (ch - 32u) : 0u;
        // Conventions 2)~4): 4 rows per word, the least significant byte is the upper row. MSB (0x80) is col = 0
        const uint bits = byte_of(glyph[g * 4u + uint(row >> 2)], uint(row & 3));
        if (bits == 0u) continue; // skip empty rows right away (space characters and glyph top/bottom margins)
        // Conventions 6),7): px = x0 + ci*8*s + col*s + i,  py = y0 + row*s + j
        const int px0 = x0 + int(ci) * (8 * s);
        const int py0 = y0 + row * s;
        for (int j = 0; j < s; ++j) {
            const int py = py0 + j;
            if (py < 0 || py >= pc.dst_h) continue;
            for (int col = 0; col < 8; ++col) {
                if (((bits >> uint(7 - col)) & 1u) == 0u) continue; // convention 5): off pixels are left untouched
                const int cx = px0 + col * s;
                // No horizontal bounds check: Vulkan guarantees out-of-range imageStore is discarded, so
                // the result equals the CPU reference's clipping (R5), and the per-pixel branch disappears
                // (same basis as store_px() in display_convert.comp).
                for (int i = 0; i < s; ++i) STORE_PX(ivec2(cx + i, py), c);
            }
        }
    }
}

void draw_detection(uint i) {
    const DetGpu d = dets[i];
    // R2: if the coordinates are not finite, skip entirely
    if (isnan(d.x1) || isnan(d.y1) || isnan(d.x2) || isnan(d.y2) || isinf(d.x1) || isinf(d.y1) || isinf(d.x2) ||
        isinf(d.y2))
        return;

    // R0 + R1
    const float fx1 = d.x1 * pc.sx + pc.tx;
    const float fy1 = d.y1 * pc.sy + pc.ty;
    const float fx2 = d.x2 * pc.sx + pc.tx;
    const float fy2 = d.y2 * pc.sy + pc.ty;
    const int ix1 = rnd(min(fx1, fx2));
    const int ix2 = rnd(max(fx1, fx2));
    const int iy1 = rnd(min(fy1, fy2));
    const int iy2 = rnd(max(fy1, fy2));

    const vec4 c = class_color(d.class_id);
    const int w = max(pc.line_width, 1);

    // R3: four sides growing inward. The union of the four bands = the set of R3's conditions.
    // Corners overlap and get written twice with the same color, so the result is the same (idempotent).
    band_h(ix1, iy1, ix2, min(iy1 + w - 1, iy2), c);              // top
    band_h(ix1, max(iy2 - w + 1, iy1), ix2, iy2, c);              // bottom
    band_v(ix1, iy1, min(ix1 + w - 1, ix2), iy2, c);              // left
    band_v(max(ix2 - w + 1, ix1), iy1, ix2, iy2, c);              // right

    if (!kDrawText) return;
    // R6: score → two integer digits. A non-finite score folds to 0 (same rule as the CPU reference).
    const float sc = (isnan(d.score) || isinf(d.score)) ? 0.0 : clamp(d.score, 0.0, 1.0);
    const uint q = uint(floor(sc * 100.0 + 0.5));
    const uint cid = min(d.class_id, 79u);
    const uint name_o = name_off[cid];
    const uint name_l = name_off[cid + 1u] - name_o;
    const int s = max(kTextScale, 1);
    const int tx0 = max(ix1, 0);
    const int ty0 = (iy1 - 16 * s >= 0) ? (iy1 - 16 * s) : max(iy1, 0);
    draw_text_run(tx0, ty0, name_l + 5u, c, false, name_o, name_l, q);
}

void main() {
    const uint g = gl_WorkGroupID.x;
    // Workgroup 0 draws the HUD **additionally** (see the dispatch convention comment)
    if (kDrawText && g == 0u && text_bytes > 0u)
        draw_text_run(kHudOriginX, kHudOriginY, min(text_bytes, 128u), vec4(1.0), true, 0u, 0u, 0u);

    const uint n = min(count, pc.max_dets);
    if (g < n) draw_detection(g);
}

#version 450
// SAND128 NV12 → letterbox RGB888 (BT.709 limited range), output layout NHWC or NHCW
//
// Reference implementation: 01_src/ref/cpu_letterbox.hpp (cpu_letterbox_nv12_bt709) + address rules in ref/sand.hpp.
// Each invocation computes 4 consecutive pixels of one output row (12 bytes = 3 uints) and writes them in 32-bit units.
//   gl_GlobalInvocationID.x = 4-pixel group index (0..dst_w/4-1), .y = output row
// The output layout is selected with specialization constant 2 (kOutNhcw); pixel value computation is identical. Only write addresses and packing differ.
//   NHWC (default, packed RGB888): idx = (dy * dst_w + dx) * 3 + c, the 3 words are contiguous
//   NHCW (HailoRT device format):  idx = (dy * 3 + c) * dst_w + dx, the 3 words are dst_w/4 apart
//   With 4-pixel groups, the 4 bytes per channel are contiguous even in NHCW, and since dst_w and dx0 are multiples of 4, word alignment always holds.
// Input Y/UV are SSBOs (uint arrays) imported directly from the dma-buf, and bytes are extracted with shifts.
//   Y(x, y)   = y_offset  + (x >> 7) * y_col_stride  + y  * 128 + (x & 127)
//   UV(x, cy) = uv_offset + (x >> 7) * uv_col_stride + cy * 128 + (x & 127)   (x even = U, odd = V)
//
// Column LUT (binding 3): values precomputed by the host per output column dx (SandLetterbox::build_lut, same float operations as the CPU reference).
//   col_lut[2*dx+0] = (Y x0 column word, Y x1 column word, UV cx0 column word, UV cx1 column word)
//                     column word = ((x >> 7) * col_stride + (x & 127)) >> 2  (the shader adds the row component)
//   col_lut[2*dx+1] = (byte shift pack: y0 | y1 << 8 | uv0 << 16 | uv1 << 24 (each 0/8/16/24),
//                      floatBits(fx), floatBits(fcx), 1 if padding column else 0)
//   Padding columns (dx < pad_x or dx >= pad_x + new_w) copy the values of the nearest content column, so reads are always valid.
// V3D has no 32-bit integer multiply (umul24 emulation) and most shader time is sample address computation and loads, so the column component was moved into a LUT
// (5.07 → 4.64 ms with a 16x4 workgroup, V3D 7.1).
// No barrier()/shared memory is used, so out-of-range invocations may return immediately.

// Workgroup size: specialization constant 0/1 (host SandLetterboxConfig::local_size_x/y)
layout(local_size_x_id = 0, local_size_y_id = 1, local_size_z = 1) in;
// Output layout: specialization constant 2 (host SandLetterboxConfig::out_layout, passed as VkBool32)
layout(constant_id = 2) const bool kOutNhcw = false;

layout(std430, set = 0, binding = 0) readonly buffer YBuf { uint y_words[]; };
layout(std430, set = 0, binding = 1) readonly buffer UVBuf { uint uv_words[]; };
layout(std430, set = 0, binding = 2) writeonly buffer OutBuf { uint out_words[]; };
layout(std430, set = 0, binding = 3) readonly buffer ColLut { uvec4 col_lut[]; };

// Same order as host SandLetterboxPush (56 B)
layout(push_constant, std430) uniform Params {
    uint y_offset;      // multiple of 4 (checked by host)
    uint y_col_stride;
    uint uv_offset;     // multiple of 4 (checked by host)
    uint uv_col_stride;
    int src_w;
    int src_h;
    int dst_w;
    int dst_h;
    int pad_x;
    int pad_y;
    int new_w;
    int new_h;
    float inv_scale;
    uint pad_value;
} pc;

float byte_at(uint w, uint sh) { return float((w >> sh) & 0xffu); }

uint to_u8(float v) {
    precise float c = clamp(v, 0.0, 255.0) + 0.5;
    return uint(c);
}

// RGB of one content pixel (each component 0..255)
// yw0/yw1: row word addresses of luma rows y0/y1, cw0/cw1: row word addresses of chroma rows cy0/cy1
uvec3 shade(int dx, uint pv, uint yw0, uint yw1, float fy, uint cw0, uint cw1, float fcy) {
    const uvec4 cols = col_lut[2 * dx];
    const uvec4 aux = col_lut[2 * dx + 1];
    const float fx = uintBitsToFloat(aux.y);
    const float fcx = uintBitsToFloat(aux.z);
    const uint sy0 = aux.x & 0xffu;
    const uint sy1 = (aux.x >> 8) & 0xffu;
    const uint su0 = (aux.x >> 16) & 0xffu;
    const uint su1 = aux.x >> 24;

    // Y bilinear. Reads all four samples without branching (on V3D a per-lane branch costs more than skipping samples: 4.6 → 3.5 ms at 16x4)
    float a = byte_at(y_words[yw0 + cols.x], sy0);
    float b = byte_at(y_words[yw0 + cols.y], sy1);
    float c = byte_at(y_words[yw1 + cols.x], sy0);
    float d = byte_at(y_words[yw1 + cols.y], sy1);
    precise float top = a + (b - a) * fx;
    precise float bot = c + (d - c) * fx;
    precise float Y = top + (bot - top) * fy;

    // UV bilinear (chroma_location = left). U/V are two consecutive bytes in the same word.
    uint wa = uv_words[cw0 + cols.z] >> su0;
    uint wc = uv_words[cw1 + cols.z] >> su0;
    vec2 ua = vec2(float(wa & 0xffu), float((wa >> 8) & 0xffu));
    vec2 uc = vec2(float(wc & 0xffu), float((wc >> 8) & 0xffu));
    uint wb = uv_words[cw0 + cols.w] >> su1;
    uint wd = uv_words[cw1 + cols.w] >> su1;
    vec2 ub = vec2(float(wb & 0xffu), float((wb >> 8) & 0xffu));
    vec2 ud = vec2(float(wd & 0xffu), float((wd >> 8) & 0xffu));
    precise vec2 ctop = ua + (ub - ua) * fcx;
    precise vec2 cbot = uc + (ud - uc) * fcx;
    precise vec2 UV = ctop + (cbot - ctop) * fcy;

    // BT.709 limited → RGB
    precise float yf = (Y - 16.0) * (255.0 / 219.0);
    precise float uf = (UV.x - 128.0) * (255.0 / 224.0);
    precise float vf = (UV.y - 128.0) * (255.0 / 224.0);
    precise float R = yf + 1.5748 * vf;
    precise float G = yf - 0.187324 * uf - 0.468124 * vf;
    precise float B = yf + 1.8556 * uf;
    const uvec3 rgb = uvec3(to_u8(R), to_u8(G), to_u8(B));
    return (aux.w != 0u) ? uvec3(pv) : rgb;
}

// For padding columns the LUT points to the nearest content column and aux.w = 1, so compute without branching and then replace with pad_value.
uvec3 pixel(int dx, uint pv, uint yw0, uint yw1, float fy, uint cw0, uint cw1, float fcy) {
    return shade(dx, pv, yw0, yw1, fy, cw0, cw1, fcy);
}

void main() {
    const int groups_per_row = pc.dst_w >> 2;
    const int gx = int(gl_GlobalInvocationID.x);
    const int dy = int(gl_GlobalInvocationID.y);
    if (gx >= groups_per_row || dy >= pc.dst_h) return; // no barrier

    // Write address: row start word + channel stride. NHWC is 3 contiguous words, NHCW is 3 words groups_per_row (= dst_w/4) apart.
    const uint row_word = uint(dy) * uint(groups_per_row) * 3u;
    const uint base = kOutNhcw ? row_word + uint(gx) : row_word + uint(gx) * 3u;
    const uint cstep = kOutNhcw ? uint(groups_per_row) : 1u;
    const uint pv = pc.pad_value & 0xffu;
    const uint pad4 = pv * 0x01010101u;

    const int dx0 = gx * 4;
    const bool row_in = dy >= pc.pad_y && dy < pc.pad_y + pc.new_h;
    if (!row_in || dx0 + 3 < pc.pad_x || dx0 >= pc.pad_x + pc.new_w) {
        out_words[base] = pad4;
        out_words[base + cstep] = pad4;
        out_words[base + 2u * cstep] = pad4;
        return;
    }

    // Per-row values (common to the 4 pixels): luma rows y0/y1, chroma rows cy0/cy1 (same expressions as cpu_letterbox.hpp)
    precise float sy = (float(dy - pc.pad_y) + 0.5) * pc.inv_scale - 0.5;
    precise float ys = clamp(sy, 0.0, float(pc.src_h - 1));
    int y0 = int(ys);
    int y1 = min(y0 + 1, pc.src_h - 1);
    precise float fy = ys - float(y0);

    int ch = pc.src_h >> 1;
    precise float cy = (sy + 0.5) * 0.5 - 0.5;
    precise float cys = clamp(cy, 0.0, float(ch - 1));
    int cy0 = int(cys);
    int cy1 = min(cy0 + 1, ch - 1);
    precise float fcy = cys - float(cy0);

    // Row word addresses (offset and 128 are multiples of 4, so they divide evenly into word units)
    const uint yw0 = (pc.y_offset >> 2) + uint(y0) * 32u;
    const uint yw1 = (pc.y_offset >> 2) + uint(y1) * 32u;
    const uint cw0 = (pc.uv_offset >> 2) + uint(cy0) * 32u;
    const uint cw1 = (pc.uv_offset >> 2) + uint(cy1) * 32u;

    // Write out the 4 pixels explicitly (with local arrays/loops the V3D compiler cannot unroll them and it gets slower)
    uvec3 c0 = pixel(dx0 + 0, pv, yw0, yw1, fy, cw0, cw1, fcy);
    uvec3 c1 = pixel(dx0 + 1, pv, yw0, yw1, fy, cw0, cw1, fcy);
    uvec3 c2 = pixel(dx0 + 2, pv, yw0, yw1, fy, cw0, cw1, fcy);
    uvec3 c3 = pixel(dx0 + 3, pv, yw0, yw1, fy, cw0, cw1, fcy);
    uvec3 w;
    if (kOutNhcw) { // 4 pixels per channel in one word
        w.x = c0.r | (c1.r << 8) | (c2.r << 16) | (c3.r << 24);
        w.y = c0.g | (c1.g << 8) | (c2.g << 16) | (c3.g << 24);
        w.z = c0.b | (c1.b << 8) | (c2.b << 16) | (c3.b << 24);
    } else {
        w.x = c0.r | (c0.g << 8) | (c0.b << 16) | (c1.r << 24);
        w.y = c1.g | (c1.b << 8) | (c2.r << 16) | (c2.g << 24);
        w.z = c2.b | (c3.r << 8) | (c3.g << 16) | (c3.b << 24);
    }
    out_words[base] = w.x;
    out_words[base + cstep] = w.y;
    out_words[base + 2u * cstep] = w.z;
}

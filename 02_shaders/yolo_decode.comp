#version 450
// YOLOv8/v11 raw output (UINT8 NHCW) → compacted candidate detections. Plan §4.3 "pass 1".
//
// ── Reference implementation ─────────────────────────────────────────────────────────────────────────────────
// **The original of the formulas is comments 1)~7) at the top of `01_src/ref/cpu_yolov8_decode.hpp`.** This shader is the
// GPU translation of those formulas, and `yvo_postproc_probe --fixture` compares it with `cpu_yolov8_candidates()`,
// judging by **same candidate count / bit-identical scores / coordinate error < 0.25 px** (plan §4.5 G5).
// When changing the formulas, fix that header first.
//
// Confirmed tensor interpretation (appendix A.5, confirmed by P1 with ratio 1.0000 by exhaustively trying 16 combinations over 40 frames):
//   · DFL channel order = `ch = coord * reg_max + bin` (reg_max = 16)
//   · sigmoid is **not applied** (the class output is already a probability)
//   · **multiple classes** per anchor — every class exceeding the threshold is emitted (not argmax)
//   · the threshold comparison is `>=`
//   · quantization is only one **scalar** per stream → push constants suffice, no LUT buffer
//
// ── Dispatch convention (plan §4.3) ───────────────────────────────────────────────────────────────
// **Once per scale, 3 dispatches in total. There is one pipeline; only the push constants differ.**
// A single dispatch sees **only 3** SSBOs, `{cls, box, det}`
// (`maxPerStageDescriptorStorageBuffers = 8`, `descriptorIndexing = false` → packing all 6 into one shader
//  means bindings cannot be chosen dynamically, so per-scale code would have to be unrolled 3 times. Rejected as worst case for the V3D compiler).
// **No barriers between the 3 dispatches** — the only interaction is `det.count`'s device-scope atomic, and
// each dispatch writes only to distinct `dets[]` slots (addresses do not overlap, so there is no race).
// Counter initialization is written to the header by the host right before submit (no `vkCmdFillBuffer` or TRANSFER_DST needed).
//
// ── invocation mapping: uint word in the w direction = 4 anchors (coalescing) ─────────────────────────────────────
// NHCW is `idx = ((h*C)+c)*W_padded + w`, so with (h,c) fixed, w is contiguous.
//   invocation (x, y) = (word column wi, row h).  One invocation handles 4 anchors (w = 4*wi .. 4*wi+3).
//   Invocations adjacent in the x direction read **adjacent words**, so they fully coalesce within a warp.
// `grid_w` is always a multiple of 4 (80/40/20), so word boundaries always line up.
// **P5 padding**: the address stride is `w_words_pad = w_padded/4 = 6`, while the valid words iterated are only `w_words = 5`
// (w 0..19). w=20..23 produce coordinates outside the 640 input via `(w+0.5)*32 >= 656`, and their values are undefined
// (appendix A.6).
//
// ── pass 1 algorithm ───────────────────────────────────────────────────────────────────────────
//  ① Class scan: load words for c = 0..79 → compare the 4 bytes with the **integer** `q_thr_low` (group joint max).
//     `q_thr_low = floor(thr/cls_scale)`, so it is a loose necessary condition (P3 57 / P4 53 / P5 52).
//     **This is almost the entire cost**: 672,000 float multiplies/compares turn into byte compares.
//  ② If the group's max does not pass, return (of 2100 groups, only a few dozen survive).
//  ③ DFL decode (once per group): the same word holds the same bin of 4 anchors, so **4 anchors are solved at once as vec4**.
//     The per-coord max is found in the integer domain (scale>0, so argmax is the same), subtracted, then 16 exps → softmax → distance.
//  ④ Inverse letterbox → **original 1920×1080 coordinates**.
//  ⑤ emit: `atomicAdd(det.count,1)`, and `atomicOr(det.overflow,1)` if the cap is exceeded.
//
// ── V3D discipline (same measured basis as the comments in `02_shaders/sand_letterbox.comp`) ───────────────────────
//   · **word load + shift instead of byte loads** (byte loads cost 4x the instructions)
//   · 32-bit integer multiplication is umul24 emulation and expensive → address computation inside loops uses only **additive accumulation**
//   · no local arrays + loops (the compiler cannot unroll them) → carry the 4 anchors as `vec4`/`uvec4`
//   · avoid per-lane branching. Early return is harmless even if divergent because there is no `barrier()`
//   · no int64 atomics (32-bit only) → counters and checksums are all uint
//
// ── Output layout: `DetGpu` 32 B + `DetBuf` header 152 B ────────────────────────────────────────
// **Byte-for-byte identical to `OverlayDetBufHeader`/`DetGpu` in `01_src/display/overlay_renderer.hpp`.**
// So this buffer can be wired directly to the overlay as-is with `vkCmdDispatchIndirect(cb, det_buf, 0)`.
//   dispatch 0..11 / count 12 / overflow 16 / text_bytes 20 / text[32] 24..151 / dets[] 152..
// Only two things are used differently from the overlay (both are documented promises):
//   · `count` is **the total number of emit attempts**. Past the cap, `count > max_dets` and `overflow = 1`.
//     Consumers clamp with `min(count, max_dets)` (`YoloPostproc::read_candidates()` does so).
//   · `text[32]` (the overlay HUD ASCII slot) is **reused as byte-sum storage** only in `kChecksum` mode.
//     text[2*scale_id] = byte sum of the class tensor's valid region, text[2*scale_id+1] = box tensor sum.
//     It is a verification-only pipeline (a separate pipeline since it is a spec constant) and does not touch the normal path.

// spec 0/1 = local_size_x/y. x is **word columns** (=4 anchors), y is rows.
layout(local_size_x_id = 0, local_size_y_id = 1, local_size_z = 1) in;
// spec 2 = byte-sum mode for verification. If true, reads everything including the box tensor and produces sums (slow. probe only).
layout(constant_id = 2) const bool kChecksum = false;

const int kRegMax = 16;    // number of DFL bins. box channel count = 4 * kRegMax = 64
const int kSides = 4;      // left, top, right, bottom
const int kBoxChannels = kSides * kRegMax;

layout(std430, set = 0, binding = 0) readonly buffer ClsBuf { uint cls_w[]; };
layout(std430, set = 0, binding = 1) readonly buffer BoxBuf { uint box_w[]; };

// Same 32 B layout as DetGpu in overlay_boxes.comp (postproc↔overlay shared contract)
struct DetGpu {
    float x1, y1, x2, y2;
    float score;
    uint class_id;
    uint anchor_key;
    uint keep;
};

// std430. Kept in agreement with the host OverlayDetBufHeader (152 B) via static_assert.
// Why dispatch is written as 3 uints instead of a uvec3: to avoid applying atomics to uvec3 components
// (the std430 layout is identical — uvec3 is at offset 0 with alignment 16, and the following uint is at offset 12).
layout(std430, set = 0, binding = 2) buffer DetBuf {
    uint dispatch_x;   // offset 0  (VkDispatchIndirectCommand.x)
    uint dispatch_y;   // offset 4
    uint dispatch_z;   // offset 8
    uint count;        // offset 12
    uint overflow;     // offset 16
    uint text_bytes;   // offset 20
    uint text[32];     // offset 24..151  (reused as byte-sum storage in kChecksum mode)
    DetGpu dets[];     // offset 152
};

layout(push_constant, std430) uniform Params {
    int grid_h;        // number of valid rows (80/40/20)
    int grid_w;        // number of valid columns (80/40/20)
    int w_words;       // number of valid words to iterate = grid_w/4 (20/10/5)
    int w_words_pad;   // number of words for the address stride = w_padded/4 (20/10/6)
    int num_classes;   // 80
    int scale_id;      // 0=P3, 1=P4, 2=P5
    uint q_thr_low;    // floor(thr / cls_scale) — integer prefilter bound
    uint max_dets;     // dets[] cap
    float stride;      // 8 / 16 / 32
    float cls_scale;
    float cls_zp;
    float box_scale;
    float box_zp;
    float thr;         // 0.2
    float inv_scale;   // 1.0 / letterbox scale
    float pad_x;
    float pad_y;
    float max_x;       // src_w  (clamp upper bound)
    float max_y;       // src_h
} pc;

uvec4 unpack4(uint w) { return uvec4(w & 0xffu, (w >> 8) & 0xffu, (w >> 16) & 0xffu, w >> 24); }
uint byte_of(uint w, int i) { return (w >> (uint(i) * 8u)) & 0xffu; }

// Solves the DFL softmax expectation of one side (16 bins) for 4 anchors at once. base is the word index of that side's first bin.
// **Extracted into a function to avoid local arrays** (the V3D compiler cannot unroll local arrays + loops — sand_letterbox discipline).
vec4 dfl_dist(int base, int Wp) {
    int bi = base;
    uvec4 mq = uvec4(0u);
    for (int b = 0; b < kRegMax; ++b) {
        mq = max(mq, unpack4(box_w[bi]));
        bi += Wp;
    }
    const vec4 m = (vec4(mq) - pc.box_zp) * pc.box_scale;
    bi = base;
    vec4 sum = vec4(0.0);
    vec4 acc = vec4(0.0);
    for (int b = 0; b < kRegMax; ++b) {
        const vec4 v = (vec4(unpack4(box_w[bi])) - pc.box_zp) * pc.box_scale;
        const vec4 e = exp(v - m);
        sum += e;
        acc += float(b) * e;
        bi += Wp;
    }
    return acc / sum;
}

void emit(float x1, float y1, float x2, float y2, float score, uint cls, uint key) {
    const uint idx = atomicAdd(count, 1u);
    if (idx >= pc.max_dets) {
        atomicOr(overflow, 1u);
        return;
    }
    dets[idx].x1 = x1;
    dets[idx].y1 = y1;
    dets[idx].x2 = x2;
    dets[idx].y2 = y2;
    dets[idx].score = score;
    dets[idx].class_id = cls;
    dets[idx].anchor_key = key;
    dets[idx].keep = 1u;
    // In case it is wired directly to the overlay, raise dispatch.x to the number of live candidates.
    // The host initializes it to (1,1,1), so workgroup 0 (HUD) runs even with 0 candidates.
    atomicMax(dispatch_x, idx + 1u);
}

#ifndef YVO_DECODE_STOP   // diagnostic stage cut (02_shaders/diag/CMakeLists.txt): 1 = after ②, 2 = after ③, 3 = after ④
#define YVO_STOP_AT(n, u)
#else   // sink every component into text[31] (kChecksum uses text[0..5]) so the cut stage is not dead-code eliminated
#define YVO_STOP_AT(n, u) if (YVO_DECODE_STOP == n) { const uvec4 s_ = (u); atomicXor(text[31], s_.x ^ s_.y ^ s_.z ^ s_.w); return; }
#endif
void main() {
    const int wi = int(gl_GlobalInvocationID.x);
    const int h = int(gl_GlobalInvocationID.y);
    if (wi >= pc.w_words || h >= pc.grid_h) return;   // no barrier() is used, so divergence is harmless

    const int Wp = pc.w_words_pad;
    const int w0 = wi * 4;

    // ── ① Class scan: integer maximum of the group (4 anchors x 80 classes) ────────────────────────────────
    // The address advances by Wp per c (no 32-bit multiplication inside the loop).
    int ci = (h * pc.num_classes) * Wp + wi;
    uvec4 gmax4 = uvec4(0u);
    uint cls_sum = 0u;
    for (int c = 0; c < pc.num_classes; ++c) {
        const uvec4 q = unpack4(cls_w[ci]);
        gmax4 = max(gmax4, q);
        if (kChecksum) cls_sum += q.x + q.y + q.z + q.w;
        ci += Wp;
    }
    if (kChecksum) {
        uint box_sum = 0u;
        int bi = (h * kBoxChannels) * Wp + wi;
        for (int ch = 0; ch < kBoxChannels; ++ch) {
            const uvec4 q = unpack4(box_w[bi]);
            box_sum += q.x + q.y + q.z + q.w;
            bi += Wp;
        }
        atomicAdd(text[2 * pc.scale_id], cls_sum);
        atomicAdd(text[2 * pc.scale_id + 1], box_sum);
    }

    // ── ② Group rejection ──────────────────────────────────────────────────────────────────────
    const uint gmax = max(max(gmax4.x, gmax4.y), max(gmax4.z, gmax4.w));
    if (gmax < pc.q_thr_low) return;
    YVO_STOP_AT(1, gmax4)

    // ── ③ DFL decode (once per group, 4 anchors at once) ────────────────────────────────────────────
    // cpu_yolov8_decode.hpp 4): ch = coord * reg_max + bin; subtract the per-coord max before softmax.
    // Finding the max in the integer domain gives the same result — box_scale > 0 preserves argmax, and
    // (max_q - zp) * scale is **the same floating-point expression** as the max of the dequantized values (bit-identical).
    const int b0 = (h * kBoxChannels) * Wp + wi;
    const int side_stride = kRegMax * Wp;
    const vec4 d_l = dfl_dist(b0, Wp);
    const vec4 d_t = dfl_dist(b0 + side_stride, Wp);
    const vec4 d_r = dfl_dist(b0 + 2 * side_stride, Wp);
    const vec4 d_b = dfl_dist(b0 + 3 * side_stride, Wp);
    YVO_STOP_AT(2, floatBitsToUint(d_l) ^ floatBitsToUint(d_t) ^ floatBitsToUint(d_r) ^ floatBitsToUint(d_b))

    // ── ④ letterbox 640 coordinates → original coordinates (cpu_yolov8_decode.hpp 5)(6)) ──────────────────
    const vec4 cx = float(w0) + vec4(0.5, 1.5, 2.5, 3.5);
    const float cy = float(h) + 0.5;
    const vec4 x1 = clamp(((cx - d_l) * pc.stride - pc.pad_x) * pc.inv_scale, 0.0, pc.max_x);
    const vec4 y1 = clamp(((cy - d_t) * pc.stride - pc.pad_y) * pc.inv_scale, 0.0, pc.max_y);
    const vec4 x2 = clamp(((cx + d_r) * pc.stride - pc.pad_x) * pc.inv_scale, 0.0, pc.max_x);
    const vec4 y2 = clamp(((cy + d_b) * pc.stride - pc.pad_y) * pc.inv_scale, 0.0, pc.max_y);
    YVO_STOP_AT(3, floatBitsToUint(x1) ^ floatBitsToUint(y1) ^ floatBitsToUint(x2) ^ floatBitsToUint(y2))

    // ── ⑤ emit: **every** class exceeding the threshold (multi-class, appendix A.5) ────────────────
    // Rescan classes per anchor. Measured cost of ⑤ is 26% of pass 1 (crowd: 41-45%, 07_results/postproc_stage_cost),
    // and in exchange the dynamic indexing of vec4 disappears (a is a constant-bound loop variable, so the compiler unrolls it).
    const uint key_hw = (uint(pc.scale_id) << 21) | (uint(h) << 14);
    for (int a = 0; a < 4; ++a) {
        const int w = w0 + a;
        if (w >= pc.grid_w) break;
        if (gmax4[a] < pc.q_thr_low) continue;   // this anchor has no class exceeding the threshold
        const uint key_a = key_hw | (uint(w) << 7);
        int cj = (h * pc.num_classes) * Wp + wi;
        for (int c = 0; c < pc.num_classes; ++c) {
            const uint q = byte_of(cls_w[cj], a);
            cj += Wp;
            if (q < pc.q_thr_low) continue;                    // integer prefilter (loose necessary condition)
            const float score = (float(q) - pc.cls_zp) * pc.cls_scale;
            if (score < pc.thr) continue;                      // definitive comparison: score >= thr
            emit(x1[a], y1[a], x2[a], y2[a], score, uint(c), key_a | uint(c));
        }
    }
}

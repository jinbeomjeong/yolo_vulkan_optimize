640×640×3
약 1.2 MB<y:LabelModel>
              <y:SmartEdgeLabelModel autoRotationEnabled="false" defaultAngle="0.0" defaultDistance="10.0"/>
            </y:LabelModel>
            <y:ModelParameter>
              <y:SmartEdgeLabelModelParameter angle="0.0" distance="6.0" distanceToCenter="false" position="left" ratio="0.5" segment="0"/>
            </y:ModelParameter>
